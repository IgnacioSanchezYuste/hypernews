# Copia este archivo a .env.local y rellena los valores.
# Genera cada secreto con: openssl rand -base64 48

# Postgres. Fuera de localhost la conexión exige TLS.
DATABASE_URL=postgres://hypernews:hypernews@localhost:5432/hypernews

# Firma las cookies de sesión del panel. Mínimo 32 caracteres.
SESSION_SECRET=

# Solo los usa `npm run db:seed` para crear o actualizar el usuario administrador.
ADMIN_EMAIL=admin@hypernews.local
ADMIN_PASSWORD=

# Autoriza /api/cron/news. Mínimo 32 caracteres.
# En Vercel se envía automáticamente como cabecera Authorization: Bearer.
CRON_SECRET=

# URL pública canónica (SEO, OpenGraph, RSS y sitemap).
NEXT_PUBLIC_SITE_URL=https://hypernews.example

# Opcionales
# Conexiones de Postgres por instancia. Súbelo solo en un servidor persistente.
# PGPOOL_MAX=5
# Ponlo a 1 únicamente si tu proveedor sirve un certificado autofirmado.
# PGSSL_NO_VERIFY=0
