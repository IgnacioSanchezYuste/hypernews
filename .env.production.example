# ─── .env de producción para news.hyperfocus.es ──────────────────────────────
# Copia este archivo a `.env` en /opt/hyperfocus/news/:
#     cp .env.production.example .env && nano .env
#
# IMPORTANTE — secretos:
#   Generarlos siempre con `openssl rand -hex 32` (nunca base64: los caracteres
#   +/= rompen la DATABASE_URL de forma silenciosa).
#
# Genera todos de una vez:
#   for v in NEWS_DB_PASSWORD SESSION_SECRET CRON_SECRET; do
#     echo "$v=$(openssl rand -hex 32)"; done

# ─── Postgres ─────────────────────────────────────────────────────────────────
# Contraseña del usuario `news` (único usuario de la base, sin exposición externa).
NEWS_DB_PASSWORD=

# ─── App ──────────────────────────────────────────────────────────────────────
# El hostname `postgres` es el nombre del servicio en docker-compose.yml.
DATABASE_URL=postgresql://news:PONER-NEWS_DB_PASSWORD-AQUI@postgres:5432/news

# Firma las cookies de sesión del panel /admin. Mínimo 32 caracteres.
SESSION_SECRET=

# Autoriza /api/cron/news (cabecera Authorization: Bearer). Mínimo 32 caracteres.
CRON_SECRET=

# Solo los usa `npm run db:seed` para crear o actualizar el usuario administrador.
ADMIN_EMAIL=admin@hyperfocus.es
ADMIN_PASSWORD=
